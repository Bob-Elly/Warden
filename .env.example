# Copy to .env, or simply run `npm run setup`, which writes a complete .env for a fresh testnet deployment.

NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://test.rpc.fastnear.com
VAULT_CONTRACT_ID=warden-vault-xxxxx.testnet

# Owner key: used only by `npm run owner` on your machine. Never put it on a server.
OWNER_ACCOUNT_ID=warden-owner-xxxxx.testnet
OWNER_PRIVATE_KEY=ed25519:...

# Agent keys: FUNCTION-CALL keys scoped to VAULT_CONTRACT_ID (execute_transfer, charge_subscription).
AGENT_ACCOUNT_ID=warden-agent-xxxxx.testnet
AGENT_PRIVATE_KEY=ed25519:...
RESEARCH_AGENT_ACCOUNT_ID=warden-research-xxxxx.testnet
RESEARCH_AGENT_PRIVATE_KEY=ed25519:...

# x402 paid-API demo: payee account (must be on the vault allowlist) and nonce HMAC secret
X402_PAY_TO=warden-api-xxxxx.testnet
X402_SECRET=change-me

# NEAR AI Cloud (optional). Without a key the agent uses a deterministic local parser.
# Get a key at https://cloud.near.ai
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
NEAR_AI_REDTEAM_MODEL=Qwen/Qwen3.8-27B-abliterated

# NEAR Intents 1Click partner JWT (optional; without it quotes carry the public fee)
ONECLICK_JWT=
