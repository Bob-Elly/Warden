# NEAR Network Configuration
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org

# Vault Account Details
VAULT_CONTRACT_ID=warden-vault.testnet
OWNER_ACCOUNT_ID=user.testnet
OWNER_PRIVATE_KEY=ed25519:...

# Restricted Agent Key (Function-Call key restricted strictly to VAULT_CONTRACT_ID::execute_transfer)
AGENT_ACCOUNT_ID=warden-agent.testnet
AGENT_PRIVATE_KEY=ed25519:...

# LLM Inference (NEAR AI Cloud / OpenAI compatible)
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_API_KEY=your-near-ai-api-key-here
NEAR_AI_MODEL=llama-3.3-70b-instruct

# Demo Mocking (Set to true to run offline deterministic simulation)
MOCK_LLM=false
