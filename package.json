{
  "name": "warden",
  "version": "0.1.0",
  "type": "module",
  "description": "Warden: The agent wallet where the AI never holds the keys (NEAR Hackathon)",
  "private": true,
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "build:contract": "cd contracts/vault && cargo build --target wasm32-unknown-unknown --release",
